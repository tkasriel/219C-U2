

module u2 {

    // Encryption and decryption functions: these are left uninterpreted
    function cdecrypt (addr_in: word_t, key: key_t) : word_t;
    function cencrypt (addr_in: word_t, key: key_t) : word_t;
    // Symbolic attacker interface: first tamper with the target ciphertext, then predict
    // the hidden payload of the plaintext recovered from the tampered ciphertext.
    function tamper (target: word_t) : word_t;
    function predict_payload (tampered_target: word_t) : word_t;
    // Is the ciphertext cryptographically unreadable?
    function is_garbled (value_in: word_t) : boolean;
    // Data encryption and decryption
    function dencrypt (value_in: word_t, key: key_t, ca: nonce_t) : word_t;
    function ddecrypt (value_in: word_t, key: key_t, ca: nonce_t) : word_t;

    // Correct decryption of a fresh pointer ciphertext.
    axiom forall (p: word_t) ::
        cdecrypt(cencrypt(p, AtKey), AtKey) == p
        && cdecrypt(cencrypt(p, ViKey), ViKey) == p;

    // Confidentiality axiom imported from the Lean development.
    axiom forall (p: word_t) ::
        is_garbled(cencrypt(p, AtKey))
        && is_garbled(cencrypt(p, ViKey));

    // The tampered target must actually differ from the honest ciphertext.
    axiom forall (target_plain: word_t) ::
        tamper(cencrypt(target_plain, AtKey))
            != cencrypt(target_plain, AtKey)
        && tamper(cencrypt(target_plain, ViKey))
            != cencrypt(target_plain, ViKey);

    // Lean-style tampering theorem: after seeing an encrypted history and a target
    // ciphertext, the attacker cannot tamper and then correctly predict the
    // plaintext recovered from that tampered ciphertext.
    axiom forall (target_plain: word_t) ::
        predict_payload(tamper(cencrypt(target_plain, AtKey)))
            != cdecrypt(tamper(cencrypt(target_plain, AtKey)), AtKey)
        && predict_payload(tamper(cencrypt(target_plain, ViKey)))
            != cdecrypt(tamper(cencrypt(target_plain, ViKey)), ViKey);

    // For a given range on the slot, what is the CA
    // that maps to this slot
    // This is the power-of-2 assumption from the C3 paper
    function slot_to_nonce (s1: word_t, s2: word_t) : nonce_t;

    function ghost_to_nonce (val: ghost_data_t) : nonce_t;

    function ghost_to_addr_value (ghost_data: ghost_data_t) : data_t;


    // Given an address what is the corresponding nonce?
    function ca_to_nonce (addr: word_t) : nonce_t;

    // Operation over the RAW value of the data
    procedure ca_decrypt (addr_in: data_t, key: key_t) 
        returns (addr_out: data_t)
    {
        addr_out = cdecrypt(addr_in, key);   
    }

    // All cryptographic operations preserve the non-crypto fields and update only the
    // explicit pointer/data protection metadata.
    procedure ghost_ca_decrypt (ghost_addr_in: ghost_data_t, key: key_t) 
        returns (ghost_addr_out: ghost_data_t)
    {
        // Core operation
        ghost_addr_out.value = cdecrypt(ghost_addr_in.value, key);
        ghost_addr_out.vtype = ghost_addr_in.vtype;
        ghost_addr_out.h_base = ghost_addr_in.h_base;
        ghost_addr_out.h_offset = ghost_addr_in.h_offset;
        ghost_addr_out.h_length = ghost_addr_in.h_length;

        ghost_addr_out.data_encrypted = ghost_addr_in.data_encrypted;
        ghost_addr_out.data_key = ghost_addr_in.data_key;
        ghost_addr_out.data_nonce = ghost_addr_in.data_nonce;
        ghost_addr_out.data_intact = ghost_addr_in.data_intact;
        ghost_addr_out.ca_nonce_true = ghost_addr_in.ca_nonce_true;
    }


    procedure ca_encrypt (addr_in: data_t, key: key_t) 
        returns (addr_out: data_t)
    {
        addr_out = cencrypt(addr_in, key);
    }

    procedure ghost_ca_encrypt (ghost_addr_in: ghost_data_t, key: key_t)
        returns (ghost_addr_out: ghost_data_t)
    {
        ghost_addr_out.value = cencrypt(ghost_addr_in.value, key);
        ghost_addr_out.vtype = ghost_addr_in.vtype;
        ghost_addr_out.h_base = ghost_addr_in.h_base;
        ghost_addr_out.h_offset = ghost_addr_in.h_offset;
        ghost_addr_out.h_length = ghost_addr_in.h_length;

        ghost_addr_out.data_encrypted = ghost_addr_in.data_encrypted;
        ghost_addr_out.data_key = ghost_addr_in.data_key;
        ghost_addr_out.data_nonce = ghost_addr_in.data_nonce;
        ghost_addr_out.data_intact = ghost_addr_in.data_intact;
        ghost_addr_out.ca_nonce_true = ghost_addr_in.ca_nonce_true;
    }


    procedure data_encrypt (data_in: data_t, key: key_t, ca: nonce_t) 
        returns (data_out: data_t)
    {
        data_out = dencrypt(data_in, key, ca);
    }
    
    procedure ghost_data_encrypt (ghost_data_in: ghost_data_t, key: key_t, ca: nonce_t, old_ghost_data: ghost_data_t) 
        returns (ghost_data_out: ghost_data_t)
    {
        // Core operation (kept uninterpreted)
        ghost_data_out.value = dencrypt(ghost_data_in.value, key, ca);
        ghost_data_out.vtype     = ghost_data_in.vtype;
        ghost_data_out.h_base     = ghost_data_in.h_base;
        ghost_data_out.h_offset   = ghost_data_in.h_offset;
        ghost_data_out.h_length   = ghost_data_in.h_length;

        ghost_data_out.data_encrypted = true;
        ghost_data_out.data_key = key;
        ghost_data_out.data_nonce = ca;
        ghost_data_out.data_intact = (old_ghost_data.ca_nonce_true == ca);
        ghost_data_out.ca_nonce_true = old_ghost_data.ca_nonce_true;
    }

    procedure data_decrypt (data_in: data_t, key: key_t, ca: nonce_t) 
        returns (data_out: data_t)
    {
        data_out = ddecrypt(data_in, key, ca);
    }

    procedure ghost_data_decrypt (ghost_data_in: ghost_data_t, key: key_t, ca: nonce_t)
        returns (ghost_data_out: ghost_data_t)
    {
        // Preserves the internal values
        ghost_data_out.value      = ddecrypt(ghost_data_in.value, key, ca);
        ghost_data_out.vtype     = ghost_data_in.vtype;
        ghost_data_out.h_base     = ghost_data_in.h_base;
        ghost_data_out.h_offset   = ghost_data_in.h_offset;
        ghost_data_out.h_length   = ghost_data_in.h_length;

        if (ghost_data_in.data_encrypted
            && ghost_data_in.data_intact
            && ghost_data_in.data_key == key
            && ghost_data_in.data_nonce == ca) {
            ghost_data_out.data_encrypted = false;
            ghost_data_out.data_key = ghost_data_in.data_key;
            ghost_data_out.data_nonce = ghost_data_in.data_nonce;
            ghost_data_out.data_intact = true;
        } else {
            ghost_data_out.data_encrypted = false;
            ghost_data_out.data_key = ghost_data_in.data_key;
            ghost_data_out.data_nonce = ghost_data_in.data_nonce;
            ghost_data_out.data_intact = false;
        }

        ghost_data_out.ca_nonce_true  = ghost_data_in.ca_nonce_true;
    }

}
